# Supabase credentials for the /admin panel and the 3D model catalog.
#
# Copy this file to .env.local and fill in the two values from your Supabase
# dashboard: Project Settings -> API.
#
# .env.local is git-ignored. Never commit real keys.
# For the live site, add the same two variables in Vercel:
# Project -> Settings -> Environment Variables.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# The dashboard calls this either "Publishable key" (newer, sb_publishable_...)
# or "anon public" (older, a long JWT). Either works — set whichever you see.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Do NOT put the service_role / secret key in this file. It bypasses every
# security policy, and anything prefixed NEXT_PUBLIC_ is shipped to browsers.
